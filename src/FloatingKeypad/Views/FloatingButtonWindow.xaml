<Window x:Class="FloatingKeypad.Views.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FloatingKeypad.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Cursor="Hand"
        Icon="/Assets/logo.png"
        Title="悬浮键鼠助手">
    <Border x:Name="Root"
            Margin="12"
            CornerRadius="10"
            ToolTip="{Binding Source={x:Static svc:Localization.Instance}, Path=[ButtonTip]}"
            Background="#CC2D7FF9"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
        </Border.Effect>
        <TextBlock x:Name="LabelText"
                   Text="按钮"
                   Foreground="White"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="10,0"
                   IsHitTestVisible="False" />
    </Border>
</Window>
