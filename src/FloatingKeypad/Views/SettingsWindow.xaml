<Window x:Class="FloatingKeypad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FloatingKeypad.Services"
        Title="{Binding Source={x:Static svc:Localization.Instance}, Path=[SettingsTitle]}"
        Icon="/Assets/logo.png"
        Width="720"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,16"
                Content="{Binding Source={x:Static svc:Localization.Instance}, Path=[AddButton]}"
                Width="104" Click="Add_Click" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="ButtonList" SelectionChanged="ButtonList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Display}" FontSize="12" Foreground="#8C8C8C" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                    Width="24" Height="24" MinWidth="0" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                    VerticalAlignment="Center" Click="ItemDelete_Click"
                                    ToolTip="{Binding Source={x:Static svc:Localization.Instance}, Path=[Delete]}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static svc:Localization.Instance}, Path=[Name]}" Margin="0,0,0,6" />
                    <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" />

                    <TextBlock Text="{Binding Source={x:Static svc:Localization.Instance}, Path=[Action]}" Margin="0,18,0,6" />
                    <Border Background="#F5F5F5" CornerRadius="6" Padding="12,8">
                        <TextBlock x:Name="BindingText"
                                   Text="{Binding Source={x:Static svc:Localization.Instance}, Path=[NotSet]}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Button Content="{Binding Source={x:Static svc:Localization.Instance}, Path=[Capture]}"
                            Width="96" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Capture_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Button Grid.Row="2" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Config_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Source={x:Static svc:Localization.Instance}, Path=[Config]}" VerticalAlignment="Center" />
                <Image Source="/Assets/setting.png" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
