<Window x:Class="FloatingKeypad.Views.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FloatingKeypad.Services"
        Title="{Binding Source={x:Static svc:Localization.Instance}, Path=[CaptureTitle]}"
        Icon="/Assets/logo.png"
        Width="460"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Source={x:Static svc:Localization.Instance}, Path=[CapturePrompt]}"
                   Foreground="#4B5563"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                CornerRadius="8"
                Background="#F5F5F5"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <TextBlock x:Name="Preview"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="12" />
        </Border>
    </Grid>
</Window>
